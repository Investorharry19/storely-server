// ============================================================
// Storely Prisma Schema
// Database: PostgreSQL
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// USERS
// ============================================================
model User {
  id           String    @id @default(uuid())
  fullName     String    @map("full_name") @db.VarChar(100)
  email        String    @unique @db.VarChar(255)
  phone        String?   @unique @db.VarChar(20)
  passwordHash String    @map("password_hash")
  isVerified   Boolean    @default(false) @map("is_verified")
  role         UserRole   @default(USER)
  status       UserStatus @default(PENDING)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  business      Business?
  otpCodes      OtpCode[]
  refreshTokens RefreshToken[]
  sessions      Session[]
  payments      Payment[]
  supportTickets SupportTicket[]
  adminActions  AdminActionLog[]

  @@map("users")
}

// ============================================================
// REFRESH TOKENS
// Raw token is NEVER stored — only a SHA-256 hash.
// Rotation: each use invalidates current and issues a new one.
// ============================================================
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  device    String?  @db.VarChar(255)
  ip        String?  @db.VarChar(45)
  location  String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ============================================================
// OTP CODES
// purpose: signup | login | password_reset
// ============================================================
model OtpCode {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  code      String   @db.VarChar(10)
  purpose   OtpPurpose
  used      Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("otp_codes")
}

// ============================================================
// BUSINESSES
// ============================================================
model Business {
  id          String       @id @default(uuid())
  userId      String       @unique @map("user_id")
  name        String       @db.VarChar(100)
  slug        String       @unique @db.VarChar(120)
  type        BusinessType
  category    String       @db.VarChar(60)
  description String?      @db.Text
  phone       String?      @db.VarChar(20)
  email       String?      @db.VarChar(255)
  website     String?      @db.VarChar(255)
  location    String?      @db.VarChar(150)
  logoUrl     String?      @map("logo_url")
  publicId     String?      @map("public_id")

  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  products      Product[]
  services      Service[]
  orders        Order[]
  aiGenerations AiGeneration[]
  payments      Payment[]

  @@index([userId])
  @@map("businesses")
}

// ============================================================
// PRODUCTS
// imageUrls: JSON array of up to 5 image URLs
// ============================================================
model Product {
  id            String   @id @default(uuid())
  businessId    String   @map("business_id")
  name          String   @db.VarChar(150)
  description   String?  @db.Text
  price         Decimal  @db.Decimal(12, 2)
  category      String?  @db.VarChar(60)
  stockQuantity Int      @default(0) @map("stock_quantity")
  isAvailable   Boolean  @default(true) @map("is_available")
  imageUrls     Json     @default("[]") @map("image_urls")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([businessId])
  @@index([isAvailable])
  @@map("products")
}

// ============================================================
// SERVICES
// priceType: fixed | starting_from
// ============================================================
model Service {
  id          String      @id @default(uuid())
  businessId  String      @map("business_id")
  name        String      @db.VarChar(150)
  description String?     @db.Text
  price       Decimal     @db.Decimal(12, 2)
  priceType   PriceType   @default(FIXED) @map("price_type")
  category    String?     @db.VarChar(60)
  imageUrl    String?     @map("image_url")
  isAvailable Boolean     @default(true) @map("is_available")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([businessId])
  @@map("services")
}

// ============================================================
// ORDERS
// status:        new | processing | completed | cancelled
// paymentStatus: pending | paid | failed
// ============================================================
model Order {
  id              String        @id @default(uuid())
  businessId      String        @map("business_id")
  customerName    String        @map("customer_name") @db.VarChar(100)
  customerPhone   String        @map("customer_phone") @db.VarChar(20)
  customerEmail   String?       @map("customer_email") @db.VarChar(255)
  deliveryAddress String?       @map("delivery_address") @db.Text
  totalAmount     Decimal       @map("total_amount") @db.Decimal(12, 2)
  status          OrderStatus   @default(NEW)
  paymentStatus   PaymentStatus @default(PENDING) @map("payment_status")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  items      OrderItem[]
  payment    Payment?

  @@index([businessId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("orders")
}

// ============================================================
// ORDER ITEMS
// itemType: product | service
// itemName + unitPrice are snapshots at time of order
// subtotal is computed in app layer (Prisma has no generated columns)
// ============================================================
model OrderItem {
  id         String   @id @default(uuid())
  orderId    String   @map("order_id")
  productId  String?  @map("product_id")
  serviceId  String?  @map("service_id")
  itemType   ItemType @map("item_type")
  itemName   String   @map("item_name") @db.VarChar(150)
  unitPrice  Decimal  @map("unit_price") @db.Decimal(12, 2)
  quantity   Int      @default(1)
  subtotal   Decimal  @db.Decimal(12, 2)

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  service  Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

// ============================================================
// AI GENERATIONS
// promptType: business_description | product_description
// ============================================================
model AiGeneration {
  id             String          @id @default(uuid())
  businessId     String          @map("business_id")
  promptType     AiPromptType    @map("prompt_type")
  inputContext   String?         @map("input_context") @db.Text
  generatedText  String          @map("generated_text") @db.Text
  createdAt      DateTime        @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("ai_generations")
}

// =============================================================
// PAYMENTS
// Standalone payment record created on successful Paystack charge.
// ============================================================
model Payment {
  id              String        @id @default(uuid())
  orderId         String        @unique @map("order_id")
  userId          String?       @map("user_id")
  businessId      String        @map("business_id")
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("NGN") @db.VarChar(3)
  status          PaymentStatus @default(PENDING)
  method          String?       @db.VarChar(50)
  paystackRef     String?       @unique @map("paystack_ref") @db.VarChar(100)
  refundedAt      DateTime?     @map("refunded_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  order           Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  issues          SupportTicket[]

  @@index([businessId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("payments")
}

// ============================================================
// SUPPORT TICKETS
// ticketType: PAYMENT_ISSUE | PLATFORM_ISSUE
// status:     OPEN | IN_PROGRESS | RESOLVED
// ============================================================
model SupportTicket {
  id          String        @id @default(uuid())
  userId      String        @map("user_id")
  paymentId   String?       @map("payment_id")
  ticketType  TicketType    @map("ticket_type")
  subject     String        @db.VarChar(200)
  description String        @db.Text
  status      TicketStatus  @default(OPEN)
  resolvedAt  DateTime?     @map("resolved_at")
  assignedTo  String?       @map("assigned_to") @db.VarChar(100)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment     Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([ticketType])
  @@index([createdAt(sort: Desc)])
  @@map("support_tickets")
}

// ============================================================
// ADMIN ACTION LOGS
// Tracks all admin actions that mutate data or affect other entities.
// ============================================================
model AdminActionLog {
  id         String                 @id @default(uuid())
  adminId    String                 @map("admin_id")
  action     AdminActionType        @map("action")
  entityType AdminActionEntityType  @map("entity_type")
  entityId   String?                @map("entity_id")
  details    Json?                  @map("details")
  createdAt  DateTime               @default(now()) @map("created_at")

  admin      User                   @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([entityType])
  @@map("admin_action_logs")
}

// ============================================================
// WAITLIST
// ============================================================
model Waitlist {
  id        String   @id @default(uuid())
  fullName  String   @map("full_name") @db.VarChar(100)
  email     String   @unique @db.VarChar(255)
  phoneNumber String? @map("phone_number") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("waitlist")
}


// ============================================================
// ENUMS
// ============================================================
enum OtpPurpose {
  SIGNUP
  LOGIN
  PASSWORD_RESET

  @@map("otp_purpose")
}

enum BusinessType {
  PRODUCT
  SERVICE
  HYBRID

  @@map("business_type")
}

enum PriceType {
  FIXED
  STARTING_FROM

  @@map("price_type")
}

enum OrderStatus {
  NEW
  PROCESSING
  COMPLETED
  CANCELLED

  @@map("order_status")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED

  @@map("payment_status")
}

enum ItemType {
  PRODUCT
  SERVICE

  @@map("item_type")
}

enum AiPromptType {
  BUSINESS_DESCRIPTION
  PRODUCT_DESCRIPTION

  @@map("ai_prompt_type")
}

enum UserRole {
  USER
  ADMIN

  @@map("user_role")
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
  BANNED

  @@map("user_status")
}

enum TicketType {
  PAYMENT_ISSUE
  PLATFORM_ISSUE

  @@map("ticket_type")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED

  @@map("ticket_status")
}

enum AdminActionType {
  BAN_USER
  WARN_USER
  SEND_MESSAGE_USER
  SEND_MESSAGE_STORE
  SUSPEND_STORE
  VERIFY_STORE
  CHANGE_PLAN_USER
  CHANGE_PLAN_STORE
  FORCE_PASSWORD_RESET

  @@map("admin_action_type")
}

enum AdminActionEntityType {
  USER
  STORE
  OTHER

  @@map("admin_action_entity_type")
}
